<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.gradusnikov.eclipse</groupId>
    <artifactId>assistai-parent</artifactId>
    <version>1.0.7-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>com.github.gradusnikov.eclipse.plugin.assistai.main.tests</artifactId>
  <packaging>eclipse-test-plugin</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <!-- Run with UI harness so IWorkbench/SWT-dependent tests can execute.
               On Linux CI this works headlessly via Xvfb (enablePreconfiguredXvfb).
               On Windows dev a brief invisible/background window may appear. -->
          <useUIHarness>true</useUIHarness>
          <useUIThread>false</useUIThread>
          <!-- Force JUnit 5/6 provider; without this Tycho picks JUnit 4 from the platform -->
          <providerHint>junit5</providerHint>
          <!-- Start Xvfb automatically on Linux so GTK display is available -->
          <enablePreconfiguredXvfb>true</enablePreconfiguredXvfb>
          <!-- Provide an Eclipse workspace so IWorkspace/JDT/M2E OSGi services initialize -->
          <appArgLine>-data ${project.build.directory}/test-workspace</appArgLine>
          <!-- Explicitly include tests that can run with UI harness.
               Excluded:
                 ChatMessageFactoryTest    - requires full interactive SWT workbench -->
          <includes>
            <include>**/*PDETest.java</include>
          </includes>
          <dependencies>
            <dependency>
              <type>eclipse-plugin</type>
              <artifactId>org.eclipse.eclemma.core</artifactId>
              <version>0.0.0</version>
            </dependency>
            <dependency>
              <type>eclipse-plugin</type>
              <artifactId>org.eclipse.jdt.junit5.runtime</artifactId>
              <version>0.0.0</version>
            </dependency>
            <dependency>
              <type>eclipse-plugin</type>
              <artifactId>org.eclipse.jdt.junit.runtime</artifactId>
              <version>0.0.0</version>
            </dependency>
            <dependency>
              <type>eclipse-plugin</type>
              <artifactId>org.eclipse.pde.junit.runtime</artifactId>
              <version>0.0.0</version>
            </dependency>
            <dependency>
              <type>eclipse-plugin</type>
              <artifactId>org.eclipse.jdt.junit4.runtime</artifactId>
              <version>0.0.0</version>
            </dependency>
          </dependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Opt-in: ./mvnw verify -Ptestng adds TestNG for Eclipse to the test runtime, so the
         TestNGLaunchServicePDETest cases that need the real launch type run (they skip
         otherwise). Off by default: AssistAI must load and be tested where TestNG is NOT
         installed, and the default build should not depend on testng.org. -->
    <profile>
      <id>testng</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>target-platform-configuration</artifactId>
            <version>${tycho.version}</version>
            <configuration>
              <target combine.children="append">
                <file>${project.basedir}/testng.target</file>
              </target>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-surefire-plugin</artifactId>
            <version>${tycho.version}</version>
            <configuration>
              <dependencies combine.children="append">
                <dependency>
                  <type>eclipse-plugin</type>
                  <artifactId>org.testng.eclipse</artifactId>
                  <version>0.0.0</version>
                </dependency>
              </dependencies>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
